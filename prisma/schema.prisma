generator client {
  provider = "prisma-client-js"
  # The runtime image may detect a different OpenSSL flavor than the
  # build stage did; include both arm64 engine variants explicitly so
  # the generated client works in either environment.
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}
